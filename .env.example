# Server (server/index.js). The API exits on startup unless both of these are set.
# Copy to server/.env (dotenv loads it) or set them in the host's environment.

# Postgres connection string (Supabase or any Postgres). The pool connects with
# TLS and rejectUnauthorized=false, so it works with Supabase's pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Secret used to sign and verify session JWTs (30-day expiry). Use a long random
# string, e.g. `openssl rand -hex 32`. Changing it signs every user out.
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on. Render sets this itself; defaults to 3000 locally.
# PORT=3000

# Frontend (Vite) reads no environment variables at build time.
